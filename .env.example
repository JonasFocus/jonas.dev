# Public Supabase project configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only Supabase secret key. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Exact sole owner user UUID, also provisioned in public.admin_users
ADMIN_USER_ID=
# Exact origin (no trailing slash), unique for each deployment environment
APP_URL=http://localhost:3000
# Random 32+ character secret used only for intake abuse-protection hashes
INTAKE_HASH_SECRET=
# Optional server-only Slack Incoming Webhook URL for new inquiry alerts. Never prefix with NEXT_PUBLIC_.
SLACK_WEBHOOK_URL=
# Optional external scheduling page; never a mail service
NEXT_PUBLIC_BOOKING_URL=

# Optional exact Vercel production origin while the custom domain is being linked
DEPLOYMENT_ORIGIN=
