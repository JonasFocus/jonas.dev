# Supabase (public)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key. Server only.
SUPABASE_SECRET_KEY=

# Exact origin, no trailing slash. One per environment.
APP_URL=http://localhost:3000

# At least 32 random characters. Used to hash IPs and emails for rate limiting.
INTAKE_HASH_SECRET=

# Optional. Slack Incoming Webhook for new inquiries. Server only.
SLACK_WEBHOOK_URL=

# Optional. One more accepted origin, such as a Vercel URL before the domain is linked.
DEPLOYMENT_ORIGIN=

# Setup only. Read by scripts/provision-owner.mjs.
OWNER_EMAIL=

# E2E only.
E2E_OWNER_EMAIL=
E2E_OWNER_PASSWORD=
E2E_BASE_URL=
